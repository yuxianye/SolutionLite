                            TextAlignment="Left"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{Binding VehicleResult[2].Key}"></TextBlock>
                <TextBlock  Grid.Row="8"
                            Grid.Column="1"
                            TextAlignment="Left"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{Binding VehicleResult[2].Value}"></TextBlock>

                <ListBox  Grid.Row="10"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          SelectedIndex="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          VerticalAlignment="Top"
                          ItemsSource="{Binding VisionResult}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240*"></ColumnDefinition>
                                    <!--<ColumnDefinition Width="90*"></ColumnDefinition>-->
                                    <ColumnDefinition Width="50"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <ProgressBar  Grid.Column="0"
                                              Maximum="1"
                                              Minimum="0"
                                              Value="{Binding Path=Value,Mode=OneWay}"
                                              ToolTip="{Binding Path=Value,Mode=OneWay,StringFormat={}{0:P2}}"></ProgressBar>
                                <Label  Grid.Column="0"
                                        FontSize="16"
                                        HorizontalAlignment="Left"
                                        Content="{Binding Path=Key,Mode=OneWay}"
                                        ToolTip="{Binding Path=Value,Mode=OneWay,StringFormat={}{0:P2}}" />
                                <TextBlock Grid.Column="0"
                                           Foreground="White"
                                           FontSize="20"
                                           HorizontalAlignment="Right"
                                           Text="{Binding Path=Value,Mode=OneWay,StringFormat={}{0:P2}}" />

                                <Button Grid.Column="1"
                                        Content="mark"></Button>
                                <!--<Label  Grid.Column="1"     FontSize="20" Content="{Binding Path=Value,Mode=OneWay,StringFormat={}{0:P2}}"></Label>-->
                                <!--<ProgressBar  Grid.Column="1"  Maximum="1" Minimum="0" Value="0.5" ></ProgressBar>-->
                                <!--<Button  Grid.Column="2" Content="Maual" ></Button>-->

                                <!--<TextBox  Grid.Column="1" Text="{Binding Path=Value,Mode=OneWay}"/>-->

                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

