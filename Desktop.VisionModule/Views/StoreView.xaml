            <!--<Image Grid.Column="2" Grid.Row="0" Stretch="Uniform " Source="{Binding CaptureImage}" ></Image>-->

            <TextBlock Grid.Row="1"
                       Grid.Column="4"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       Text="捕获画面"></TextBlock>
            <Image Grid.Column="4"
                   Grid.Row="0"
                   Stretch="Uniform "
                   Source="{Binding CaptureImage}"></Image>

            <Grid Grid.Column="2"
                  Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <!--  <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition></RowDefinition>-->

                </Grid.RowDefinitions>
                <TextBlock  Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            TextAlignment="Center"
                            FontSize="35"
                            Text="Predicted Result"></TextBlock>

                <TextBlock  Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            TextAlignment="Center"
                            FontSize="35"
                            FontWeight="Bold"
                            Text="{Binding VisionResult[0].Key}"></TextBlock>

                <TextBlock  Grid.Row="4"
                            Grid.Column="0"
                            TextAlignment="Left"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{Binding VehicleResult[0].Key}"></TextBlock>
                <TextBlock  Grid.Row="4"
                            Grid.Column="1"
                            TextAlignment="Left"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{Binding VehicleResult[0].Value}"></TextBlock>
                <TextBlock  Grid.Row="6"
                            Grid.Column="0"
                            TextAlignment="Left"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{Binding VehicleResult[1].Key}"></TextBlock>
                <TextBlock  Grid.Row="6"
